workDir = "${params.work}"
cleanup = false
executor.queueSize = 8
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'retry'
    maxRetries = 1
}

// Optional local execution using the pinned container.
profiles {
    docker {
        process.executor = 'local'
        docker.enabled = true
    }
}
